<UserControl x:Class="LibOps.PresentationLayer.Views.ReaderOpacSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LibOps.PresentationLayer.ViewModels"
             xmlns:conv="clr-namespace:LibOps.PresentationLayer.Converters"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReaderOpacSearchViewModel}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />

        <!-- Card Button Style for Book Grid -->
        <Style x:Key="BookCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrandIndigoBrush}" />
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource FloatingShadow}" />
                                <Setter Property="Background" Value="#FDFDFE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrandPinkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Item Style -->
        <Style x:Key="CategoryItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CatBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER TIÊU ĐỀ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="TRA CỨU MỤC LỤC SÁCH THƯ VIỆN" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Kho tài nguyên học tập và nghiên cứu - Tra cứu theo danh mục chuyên ngành và vị trí kệ sách" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- BỐ CỤC 2 CỘT (2 COLUMNS LAYOUT) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI (SIDEBAR BỘ LỌC 25%) -->
            <StackPanel Grid.Column="0">
                
                <!-- CARD DANH MỤC THỂ LOẠI -->
                <Border Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Width="16" Height="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="THỂ LOẠI TÀI LIỆU" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CategoryItemButtonStyle}" 
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CategoryName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding BookCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- CARD BỘ LỌC & SẮP XẾP -->
                <Border Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="FilterVariant" Width="16" Height="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="BỘ LỌC &amp; SẮP XẾP" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sắp xếp theo -->
                        <TextBlock Text="Sắp xếp theo:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,12"
                                  SelectedValue="{Binding SelectedSortOption, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Tag="DEFAULT" Content="Mặc định" IsSelected="True"/>
                            <ComboBoxItem Tag="BORROW_DESC" Content="Mượn nhiều nhất"/>
                            <ComboBoxItem Tag="TITLE_ASC" Content="Tên sách (A → Z)"/>
                            <ComboBoxItem Tag="TITLE_DESC" Content="Tên sách (Z → A)"/>
                            <ComboBoxItem Tag="YEAR_DESC" Content="Năm xuất bản (Mới nhất)"/>
                            <ComboBoxItem Tag="PRICE_ASC" Content="Giá bìa (Thấp → Cao)"/>
                        </ComboBox>

                        <!-- Tình trạng -->
                        <TextBlock Text="Tình trạng:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <CheckBox Content="Chỉ sách còn sẵn sàng" 
                                  IsChecked="{Binding OnlyAvailable, Mode=TwoWay}" 
                                  FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,14" Cursor="Hand"/>

                        <Button Command="{Binding ResetFiltersCommand}" Style="{StaticResource OutlineButton}" Height="36">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Đặt Lại Bộ Lọc" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CỘT PHẢI (MAIN CONTENT 75%) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- THANH TÌM KIẾM & CHẾ ĐỘ XEM -->
                <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="12" Margin="8,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ô tìm kiếm -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Style="{StaticResource ModernTextBox}" 
                                     Tag="Tìm kiếm theo tựa đề, tác giả, NXB, ISBN..."
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="38">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>

                        <!-- Nút chuyển đổi View Mode (Lưới vs Danh sách) -->
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Background="{Binding IsGridView, Converter={StaticResource BoolToStatusBackgroundConverter}, FallbackValue='#FFFFFF'}">
                                    <Button Command="{Binding SetGridViewCommand}" 
                                            Background="Transparent" BorderThickness="0" Width="32" Height="30" ToolTip="Xem dạng Lưới Thẻ (Grid Cards)" Cursor="Hand">
                                        <iconPacks:PackIconMaterial Kind="ViewGrid" Width="14" Height="14" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Border>
                                <Border CornerRadius="4" Margin="2,0,0,0" Background="{Binding IsListView, Converter={StaticResource BoolToStatusBackgroundConverter}, FallbackValue='Transparent'}">
                                    <Button Command="{Binding SetListViewCommand}" 
                                            Background="Transparent" BorderThickness="0" Width="32" Height="30" ToolTip="Xem dạng Danh Sách Chi Tiết (List Table)" Cursor="Hand">
                                        <iconPacks:PackIconMaterial Kind="ViewHeadline" Width="14" Height="14" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- KHU VỰC HIỂN THỊ DANH SÁCH SÁCH -->
                <Grid Grid.Row="1">
                    
                    <!-- THÔNG BÁO KHÔNG TÌM THẤY -->
                    <Border Visibility="{Binding HasNoBooks, Converter={StaticResource BoolToVisConverter}}"
                            Style="{StaticResource ModernCard}" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="BookOffOutline" Width="52" Height="52" Foreground="{StaticResource SlateMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Không tìm thấy tài liệu phù hợp" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vui lòng thử thay đổi từ khóa tìm kiếm hoặc bấm 'Đặt Lại Bộ Lọc'." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Command="{Binding ResetFiltersCommand}" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="16,0" HorizontalAlignment="Center">
                                <TextBlock Text="Đặt Lại Bộ Lọc"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 1. CHẾ ĐỘ XEM LƯỚI THẺ SÁCH (GRID VIEW) -->
                    <ScrollViewer Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisConverter}}"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OpacBooks}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BookCardButtonStyle}" 
                                            Margin="7,0,7,16" Width="210"
                                            Command="{Binding DataContext.ViewBookDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="320"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Ảnh bìa -->
                                            <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="#F1F5F9">
                                                <Grid>
                                                    <Border CornerRadius="10,10,0,0" Height="320"
                                                            Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Border CornerRadius="10,10,0,0" Background="#F8FAFC"
                                                            Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBoolToVisConverter}}">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline" Width="38" Height="38" Foreground="{StaticResource SlateMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                            <TextBlock Text="LibOps" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SlateMutedBrush}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                            Margin="6" Padding="6,2.5" CornerRadius="5"
                                                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="Có sẵn" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                            Margin="6" Padding="6,2.5" CornerRadius="5"
                                                            Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                                            Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisConverter}}">
                                                        <TextBlock Text="Đã mượn" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Chi tiết -->
                                            <StackPanel Grid.Row="1" Margin="10,8">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" 
                                                           MaxHeight="34" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" LineHeight="16"/>
                                                <TextBlock Text="{Binding AuthorName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ShelfLocation, StringFormat='Kệ: {0}'}" FontSize="10.5" Foreground="{StaticResource BrandIndigoBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 2. CHẾ ĐỘ XEM DANH SÁCH CHI TIẾT (LIST ROW VIEW) -->
                    <ScrollViewer Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OpacBooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModernCard}" Padding="12" Margin="8,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail -->
                                            <Border Grid.Column="0" Width="55" Height="75" CornerRadius="6" Background="#F1F5F9" Margin="0,0,10,0">
                                                <Grid>
                                                    <Border CornerRadius="6" Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline" Width="20" Height="20" Foreground="{StaticResource SlateMutedBrush}" 
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                        <TextBlock Text="LibOps" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SlateMutedBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>                                                 
                                                </Grid>
                                            </Border>

                                            <!-- Tên sách & Tác giả -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AuthorName, StringFormat='Tác giả: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding CategoryName, StringFormat='Thể loại: {0}'}" FontSize="11.5" Foreground="{StaticResource BrandIndigoBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Vị trí kệ -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Vị trí kệ:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ShelfLocation}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Trạng thái còn sách -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Khả dụng:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="Có sẵn" FontSize="12.5" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"
                                                           Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisConverter}}"/>
                                                <TextBlock Text="Đã mượn" FontSize="12.5" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"
                                                           Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                            </StackPanel>

                                            <!-- Nút Xem chi tiết -->
                                            <Button Grid.Column="4" Style="{StaticResource PrimaryGradientButton}" Height="34" Padding="10,0"
                                                    Command="{Binding DataContext.ViewBookDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <iconPacks:PackIconMaterial Kind="EyeOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Chi Tiết" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PHÂN TRANG -->
                <controls:PaginationControl Grid.Row="2" DataContext="{Binding Paging}" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
