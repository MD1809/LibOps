<Window x:Class="LibOps.PresentationLayer.Views.CloseCardRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Yêu cầu hủy thẻ và hoàn tiền cọc" 
        Height="620" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#881337" Offset="0.0"/>
                        <GradientStop Color="#BE123C" Offset="0.6"/>
                        <GradientStop Color="#E11D48" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CardRemoveOutline" Width="22" Height="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Yêu cầu hủy thẻ và hoàn tiền cọc" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Gửi yêu cầu hủy thẻ thư viện và nhận lại tiền cọc" FontSize="12" Foreground="#FFE4E6" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>
                    <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số dư tiền cọc sẽ được hoàn lại:" FontSize="12" Foreground="#9F1239" FontWeight="SemiBold"/>
                                <TextBlock Text="Sau khi thủ thư xét duyệt đóng thẻ thành công" FontSize="11.5" Foreground="#BE123C" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="txtRefundAmount" Text="200.000 đ" FontSize="16" FontWeight="Bold" Foreground="#BE123C" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Chọn hình thức nhận tiền hoàn:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <RadioButton x:Name="rbBankTransfer" IsChecked="True" Checked="PaymentMethod_Changed" Margin="0,0,0,8" GroupName="PayoutMethod">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BankTransfer" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Chuyển khoản ngân hàng (Khuyến nghị)" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="rbCash" Checked="PaymentMethod_Changed" Margin="0,0,0,14" GroupName="PayoutMethod">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CashMultiple" Width="16" Height="16" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Nhận tiền mặt trực tiếp tại quầy thư viện" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Border x:Name="pnlBankDetails" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Ngân hàng thụ hưởng (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboBank" Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,10" DisplayMemberPath="Name"/>

                            <TextBlock Text="Số tài khoản (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtAccountNumber" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"/>

                            <TextBlock Text="Tên chủ tài khoản (in hoa) (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtAccountHolder" Style="{StaticResource ModernTextBox}" CharacterCasing="Upper" Height="36"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="pnlCashNotice" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Hướng dẫn nhận tiền mặt:" FontWeight="SemiBold" FontSize="12" Foreground="#166534" Margin="0,0,0,4"/>
                            <TextBlock Text="Sau khi yêu cầu được thủ thư duyệt, vui lòng mang theo Căn cước công dân hoặc Thẻ sinh viên đến quầy thủ thư để nhận tiền mặt và ký nhận Phiếu Chi." FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Lý do hủy thẻ (tùy chọn):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtReason" Style="{StaticResource ModernTextBox}" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8" Text="Độc giả yêu cầu hủy thẻ và nhận lại tiền cọc"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Hủy bỏ" Click="CloseButton_Click" Style="{StaticResource OutlineButton}" Height="38" Margin="0,0,10,0"/>

                    <Button Grid.Column="1" Click="SubmitButton_Click" Style="{StaticResource DangerButton}" Height="38" Padding="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="SendCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Gửi yêu cầu hủy thẻ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
