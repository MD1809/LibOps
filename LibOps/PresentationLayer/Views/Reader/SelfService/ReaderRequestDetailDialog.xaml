<Window x:Class="LibOps.PresentationLayer.Views.ReaderRequestDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Chi tiết yêu cầu tự phục vụ" 
        Height="600" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#312E81" Offset="0.5"/>
                        <GradientStop Color="#4F46E5" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#C7D2FE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Chi tiết yêu cầu tự phục vụ" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Xem nội dung chi tiết yêu cầu và phản hồi từ ban quản lý thư viện" FontSize="12" Foreground="#C7D2FE" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtRequestCode" Text="Mã yêu cầu: #REQ-20260001" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="txtRequestDate" Text="Ngày gửi: 12/09/2026 10:30" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="badgeStatus" Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtStatus" Text="Chờ duyệt" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                </Border>
                                <Border x:Name="badgeType" Background="#EEF2FF" CornerRadius="6" Padding="8,4">
                                    <TextBlock x:Name="txtRequestType" Text="Cập nhật thông tin" FontSize="11.5" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="pnlCancelCard" Visibility="Collapsed" Margin="0,0,0,14">
                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số tiền cọc đề nghị hoàn trả:" FontSize="12" FontWeight="SemiBold" Foreground="#9F1239"/>
                                    <TextBlock x:Name="txtPayoutMethod" Text="Hình thức: Chuyển khoản ngân hàng" FontSize="11.5" Foreground="#BE123C" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="txtRefundAmount" Text="200.000 đ" FontSize="15" FontWeight="SemiBold" Foreground="#BE123C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="pnlBankTransferInfo" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Tài khoản ngân hàng thụ hưởng:" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtBankName" Text="Ngân hàng: MBBank" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="txtAccountNo" Text="Số tài khoản: 0987654321" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                <TextBlock x:Name="txtAccountHolder" Text="Chủ tài khoản: NGUYỄN VĂN A" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="pnlCashInfo" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock Text="Hình thức nhận: Nhận trực tiếp tiền mặt tại quầy thủ thư khi trả lại thẻ." FontSize="12" Foreground="#15803D" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="TextBoxOutline" Width="14" Height="14" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Nội dung độc giả đã gửi" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandIndigoBrush}"/>
                            </StackPanel>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBox x:Name="txtReasonFull" 
                                         Text="Nội dung chi tiết yêu cầu..." 
                                         TextWrapping="Wrap" 
                                         IsReadOnly="True" 
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         FontSize="12.5" 
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         MaxHeight="150"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="MessageReplyTextOutline" Width="14" Height="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Phản hồi và kết quả xử lý" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Border x:Name="pnlPendingNotice" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ClockOutline" Width="16" Height="16" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Yêu cầu đang chờ ban quản lý và thủ thư tiếp nhận xử lý." FontSize="12" Foreground="#B45309" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="pnlProcessedResult" Visibility="Collapsed">
                                <TextBlock x:Name="txtProcessedInfo" Text="Đã xử lý bởi: Thủ thư • Ngày: 12/09/2026 15:00" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <TextBox x:Name="txtStaffNotesFull" 
                                             Text="Không có ghi chú thêm." 
                                             TextWrapping="Wrap" 
                                             IsReadOnly="True" 
                                             BorderThickness="0" 
                                             Background="Transparent" 
                                             FontSize="12.5" 
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             MaxHeight="120"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="20,12" Background="#FAFAFA" CornerRadius="0,0,15,15">
                <Button Click="CloseButton_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Width="110" HorizontalAlignment="Right" Cursor="Hand">
                    <TextBlock Text="Đóng" FontWeight="SemiBold" FontSize="12.5"/>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
