<UserControl x:Class="LibOps.PresentationLayer.Views.ReaderSelfServiceRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LibOps.PresentationLayer.ViewModels"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReaderSelfServiceRequestsViewModel}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Trang -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TRUNG TÂM THEO DÕI YÊU CẦU VÀ TỰ PHỤC VỤ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Gửi yêu cầu cấp lại thẻ, cập nhật hồ sơ, góp ý, hủy thẻ và theo dõi trực tiếp tiến trình xét duyệt từ Thủ thư" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- 2. Thân Trang 2 Cột -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: THẺ TRẠNG THÁI & CÁC NÚT TẠO YÊU CẦU -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- Card Tóm tắt tình trạng Thẻ -->
                    <Border Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TÌNH TRẠNG THẺ HIỆN TẠI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số dư tiền cọc:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MemberCardSummary.DepositBalance, StringFormat={}{0:N0} đ, FallbackValue='0 đ'}" 
                                           FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sách đang mượn:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MemberCardSummary.ActiveBorrowCount, StringFormat='{}{0} cuốn', FallbackValue='0 cuốn'}" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nợ phạt hiện tại:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MemberCardSummary.TotalDebt, StringFormat={}{0:N0} đ, FallbackValue='0 đ'}" 
                                           FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                            </Grid>

                            <!-- Nút Gửi Yêu Cầu Tự Phục Vụ (Cấp lại thẻ, Cập nhật thông tin, Góp ý) -->
                            <Button Command="{Binding CreateGeneralRequestCommand}" Style="{StaticResource PrimaryGradientButton}" Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Gửi Yêu Cầu Tự Phục Vụ" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Card Hướng dẫn các dịch vụ tự phục vụ -->
                    <Border Style="{StaticResource ModernCard}" Background="#F8FAFC" Padding="16">
                        <StackPanel>
                            <TextBlock Text="DANH MỤC DỊCH VỤ HỖ TRỢ" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrandIndigoBrush}" Margin="0,0,0,10"/>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Báo Mất &amp; Cấp Lại Thẻ:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Hệ thống tự động tạm khóa thẻ để bảo vệ tài khoản, thủ thư cấp thẻ mới tại quầy." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Cập Nhật Thông Tin:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Đính chính SĐT, Email, Địa chỉ nhanh chóng mà không cần đến thư viện." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Góp Ý &amp; Yêu Cầu Hỗ Trợ:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Gửi câu hỏi, thắc mắc về phí phạt, dịch vụ để nhận phản hồi trực tiếp từ thủ thư." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- CỘT PHẢI: BẢNG THEO DÕI TIẾN TRÌNH YÊU CẦU -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header & Bộ Lọc Trạng Thái -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TIẾN TRÌNH XỬ LÝ CÁC YÊU CẦU ĐÃ GỬI" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Theo dõi trạng thái duyệt và phản hồi từ ban quản lý thư viện" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Bộ lọc trạng thái -->
                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="34" Width="160" Margin="0,0,8,0"
                                  SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Tag="ALL" Content="Tất cả trạng thái" IsSelected="True"/>
                            <ComboBoxItem Tag="PENDING" Content="Đang chờ duyệt"/>
                            <ComboBoxItem Tag="APPROVED" Content="Đã phê duyệt"/>
                            <ComboBoxItem Tag="REJECTED" Content="Đã từ chối"/>
                        </ComboBox>

                        <!-- Nút làm mới -->
                        <Button Grid.Column="2" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" Height="34" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Làm Mới" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Danh sách DataGrid các yêu cầu -->
                    <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" 
                              ItemsSource="{Binding MyRequests}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestCode}" FontWeight="Bold" Width="120"/>
                            <DataGridTextColumn Header="Loại Yêu Cầu" Binding="{Binding RequestTypeDisplay}" FontWeight="SemiBold" Width="160"/>
                            <DataGridTextColumn Header="Số Tiền" Binding="{Binding FormattedAmount}" FontWeight="Bold" Width="110"/>
                            <DataGridTextColumn Header="Ngày Gửi" Binding="{Binding FormattedRequestDate}" Width="140"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" FontWeight="Bold" Width="120"/>
                            <DataGridTextColumn Header="Nội Dung Độc Giả Gửi" Binding="{Binding Reason}" Width="240"/>
                            <DataGridTextColumn Header="Phản Hồi / Ghi Chú Thủ Thư" Binding="{Binding StaffNotes}" Width="280"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Phân trang -->
                    <controls:PaginationControl Grid.Row="2" DataContext="{Binding Paging}" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
