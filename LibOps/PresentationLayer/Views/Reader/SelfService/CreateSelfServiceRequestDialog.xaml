<Window x:Class="LibOps.PresentationLayer.Views.CreateSelfServiceRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Tạo Yêu Cầu Tự Phục Vụ Mới" 
        Height="580" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Gradient Xanh Indigo -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#312E81" Offset="0.5"/>
                        <GradientStop Color="#4F46E5" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="HandHeartOutline" Width="22" Height="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GỬI YÊU CẦU TỰ PHỤC VỤ" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Chọn loại yêu cầu cần gửi tới Ban Quản Lý Thư Viện" FontSize="11.5" Foreground="#C7D2FE" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Thân Dialog -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>
                    <!-- Chọn Loại Yêu Cầu -->
                    <TextBlock Text="CHỌN LOẠI YÊU CẦU (*):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cboRequestType" SelectionChanged="RequestType_SelectionChanged" Style="{StaticResource ModernComboBox}" Height="38" Margin="0,0,0,16">
                        <ComboBoxItem Tag="REISSUE_CARD" IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CardRemoveOutline" Width="15" Height="15" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Báo Mất Thẻ &amp; Yêu Cầu Cấp Lại Thẻ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="UPDATE_INFO">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountEditOutline" Width="15" Height="15" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cập Nhật / Đính Chính Thông Tin Cá Nhân" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="FEEDBACK_INQUIRY">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="EmailOutline" Width="15" Height="15" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Khiếu Nại / Góp Ý / Yêu Cầu Hỗ Trợ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <!-- KHUNG 1: FORM BÁO MẤT THẺ -->
                    <Border x:Name="pnlReissueCard" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="LƯU Ý AN TOÀN KHI BÁO MẤT THẺ:" FontWeight="Bold" FontSize="11.5" Foreground="#B45309" Margin="0,0,0,6"/>
                            <TextBlock Text="• Ngay sau khi bạn gửi yêu cầu, hệ thống sẽ TỰ ĐỘNG TẠM KHÓA THẺ để bảo vệ tài khoản và tránh kẻ gian lạm dụng." FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="• Thủ thư sẽ tiếp nhận và cấp phôi thẻ mới cho bạn khi bạn đến nhận tại quầy." FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Lý Do &amp; Thời Gian Mất Thẻ (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtReissueReason" Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Text="Tôi bị rơi ví và mất thẻ thư viện, kính đề nghị thư viện cấp lại thẻ mới."/>
                        </StackPanel>
                    </Border>

                    <!-- KHUNG 2: FORM CẬP NHẬT THÔNG TIN -->
                    <Border x:Name="pnlUpdateInfo" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Nhập các thông tin mới cần cập nhật vào hồ sơ:" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,10"/>

                            <TextBlock Text="Số Điện Thoại Mới:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNewPhone" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Địa Chỉ Email Mới:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNewEmail" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Địa Chỉ Cư Trú Mới:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNewAddress" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Lý Do Cập Nhật:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtUpdateReason" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Text="Tôi đã thay đổi số điện thoại và địa chỉ mới"/>
                        </StackPanel>
                    </Border>

                    <!-- KHUNG 3: FORM GÓP Ý / HỖ TRỢ -->
                    <Border x:Name="pnlFeedback" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Tiêu Đề Yêu Cầu / Thắc Mắc (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtFeedbackSubject" Style="{StaticResource ModernTextBox}" Height="34" Text="Thắc mắc về quy định mượn sách chuyên ngành" Margin="0,0,0,10"/>

                            <TextBlock Text="Nội Dung Chi Tiết (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtFeedbackContent" Style="{StaticResource ModernTextBox}" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Text="Kính gửi ban quản lý thư viện, tôi muốn hỏi..."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Buttons -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Hủy Bỏ" Click="CloseButton_Click" Style="{StaticResource OutlineButton}" Height="38" Margin="0,0,10,0"/>

                    <Button Grid.Column="1" Click="SubmitButton_Click" Style="{StaticResource PrimaryGradientButton}" Height="38" Padding="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="SendCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Gửi Yêu Cầu Tới Thủ Thư" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
