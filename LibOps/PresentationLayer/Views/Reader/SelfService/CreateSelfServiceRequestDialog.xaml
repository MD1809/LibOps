<Window x:Class="LibOps.PresentationLayer.Views.CreateSelfServiceRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Tạo yêu cầu tự phục vụ" 
        Height="580" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#312E81" Offset="0.5"/>
                        <GradientStop Color="#4F46E5" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="HandHeartOutline" Width="22" Height="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Gửi yêu cầu tự phục vụ" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Chọn loại yêu cầu cần gửi tới ban quản lý thư viện" FontSize="12" Foreground="#C7D2FE" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>
                    <TextBlock Text="Chọn loại yêu cầu (*):" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cboRequestType" SelectionChanged="RequestType_SelectionChanged" Style="{StaticResource ModernComboBox}" Height="38" Margin="0,0,0,16">
                        <ComboBoxItem Tag="REISSUE_CARD" IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CardRemoveOutline" Width="15" Height="15" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Báo mất thẻ và yêu cầu cấp lại thẻ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="UPDATE_INFO">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountEditOutline" Width="15" Height="15" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cập nhật và đính chính thông tin cá nhân" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="FEEDBACK_INQUIRY">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="EmailOutline" Width="15" Height="15" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Khiếu nại, góp ý và yêu cầu hỗ trợ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <Border x:Name="pnlReissueCard" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Lưu ý an toàn khi báo mất thẻ:" FontWeight="SemiBold" FontSize="12" Foreground="#B45309" Margin="0,0,0,6"/>
                            <TextBlock Text="• Ngay sau khi bạn gửi yêu cầu, hệ thống sẽ tự động tạm khóa thẻ để bảo vệ tài khoản và tránh kẻ gian lạm dụng." FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="• Thủ thư sẽ tiếp nhận và cấp phôi thẻ mới cho bạn khi bạn đến nhận tại quầy." FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Lý do và thời gian mất thẻ (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtReissueReason" Style="{StaticResource ModernTextBox}" Tag="Nhập lý do và thời gian mất thẻ..." Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="pnlUpdateInfo" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Nhập các thông tin mới cần cập nhật vào hồ sơ:" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,10"/>

                            <TextBlock Text="Số điện thoại mới:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNewPhone" Style="{StaticResource ModernTextBox}" Tag="Nhập số điện thoại mới..." Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Địa chỉ email mới:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNewEmail" Style="{StaticResource ModernTextBox}" Tag="Nhập địa chỉ email mới..." Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Địa chỉ cư trú mới:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNewAddress" Style="{StaticResource ModernTextBox}" Tag="Nhập địa chỉ cư trú mới..." Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Lý do cập nhật:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtUpdateReason" Style="{StaticResource ModernTextBox}" Tag="Nhập lý do cập nhật thông tin..." Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="pnlFeedback" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Tiêu đề yêu cầu hoặc thắc mắc (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtFeedbackSubject" Style="{StaticResource ModernTextBox}" Tag="Nhập tiêu đề yêu cầu hoặc thắc mắc..." Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="Nội dung chi tiết (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtFeedbackContent" Style="{StaticResource ModernTextBox}" Tag="Nhập nội dung chi tiết thắc mắc, góp ý..." Height="95" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Hủy bỏ" Click="CloseButton_Click" Style="{StaticResource OutlineButton}" Height="38" Margin="0,0,10,0"/>

                    <Button Grid.Column="1" Click="SubmitButton_Click" Style="{StaticResource PrimaryGradientButton}" Height="38" Padding="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="SendCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Gửi yêu cầu tới thủ thư" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
