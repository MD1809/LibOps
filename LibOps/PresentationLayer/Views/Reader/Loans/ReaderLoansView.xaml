<UserControl x:Class="LibOps.PresentationLayer.Views.ReaderLoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LibOps.PresentationLayer.ViewModels"
             xmlns:converters="clr-namespace:LibOps.PresentationLayer.Converters"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReaderLoansViewModel}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Style cho Sub-Tab Segmented RadioButton -->
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Color="#000000" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style căn lề ô DataGrid -->
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Tiêu Đề -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ MƯỢN VÀ TRẢ SÁCH" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Theo dõi hạn trả, chủ động gia hạn sách trực tuyến hoặc tra cứu toàn bộ lịch sử hoàn trả sách" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- Thanh Chuyển Sub-Tabs & Nút Thao Tác -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Bộ nút Segment Tabs -->
            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton IsChecked="{Binding IsActiveLoansSubTabSelected}"
                                 GroupName="ReaderLoansSubTabs"
                                 Style="{StaticResource SegmentRadioButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="BookClock" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Sách Đang Mượn" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsReturnHistorySubTabSelected}"
                                 GroupName="ReaderLoansSubTabs"
                                 Style="{StaticResource SegmentRadioButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="BookCheckOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Lịch Sử Sách Đã Trả" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Nút chức năng bên phải -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshLoansCommand}" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm Mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RenewLoanCommand}" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="16,0"
                        Visibility="{Binding IsActiveLoansSubTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ClockFast" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Tự Gia Hạn Sách" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- BẢNG 1: SÁCH ĐANG MƯỢN -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0"
                Visibility="{Binding IsActiveLoansSubTabSelected, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          Style="{StaticResource ModernDataGrid}" 
                          ItemsSource="{Binding ActiveLoans}"
                          SelectedItem="{Binding SelectedLoan}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding SlipCode}" FontWeight="Bold" Width="120" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Mã Vạch" Binding="{Binding Barcode}" Width="120" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Tựa Đề Sách" Binding="{Binding BookTitle}" FontWeight="SemiBold" Width="280"/>
                        <DataGridTextColumn Header="Ngày Mượn" Binding="{Binding BorrowDate, StringFormat=dd/MM/yyyy}" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Hạn Trả" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" FontWeight="Bold" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Còn Lại (Ngày)" Binding="{Binding DaysRemaining}" FontWeight="Bold" Width="120" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Đã Gia Hạn" Binding="{Binding RenewalCount, StringFormat={}{0} lần}" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationControl Grid.Row="1" DataContext="{Binding ActiveLoansPaging}" />
            </Grid>
        </Border>

        <!-- BẢNG 2: LỊCH SỬ SÁCH ĐÃ TRẢ -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0"
                Visibility="{Binding IsReturnHistorySubTabSelected, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          Style="{StaticResource ModernDataGrid}" 
                          ItemsSource="{Binding ReturnHistories}"
                          SelectedItem="{Binding SelectedReturnHistory}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding SlipCode}" FontWeight="Bold" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Mã Vạch" Binding="{Binding Barcode}" Width="120" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Tựa Đề Sách" Binding="{Binding BookTitle}" FontWeight="SemiBold" Width="260"/>
                        <DataGridTextColumn Header="Ngày Mượn" Binding="{Binding FormattedBorrowDate}" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Hạn Trả" Binding="{Binding FormattedDueDate}" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Ngày Trả Thực" Binding="{Binding FormattedActualReturnDate}" FontWeight="Bold" Width="120" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Tình Trạng Hạn" Binding="{Binding StatusDisplay}" FontWeight="SemiBold" Width="140" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Hiện Trạng Sách" Binding="{Binding BookCopyStatusDisplay}" Width="120" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Phí Phạt" Binding="{Binding FormattedFineAmount}" FontWeight="Bold" Width="110" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Thủ Thư Tiếp Nhận" Binding="{Binding ReceivedByStaffName}" Width="140"/>
                        <DataGridTextColumn Header="Ghi Chú Trả" Binding="{Binding ReturnConditionNote}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationControl Grid.Row="1" DataContext="{Binding ReturnHistoriesPaging}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
