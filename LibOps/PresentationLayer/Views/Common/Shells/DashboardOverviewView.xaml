<UserControl x:Class="LibOps.PresentationLayer.Views.DashboardOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            
            <!-- TIÊU ĐỀ PHÂN HỆ & NÚT LÀM MỚI -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="BẢNG ĐIỀU KHIỂN TRUNG TÂM"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Tổng hợp chỉ số KPI thời gian thực, xu hướng lưu thông và nhật ký hoạt động thư viện"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="36"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Làm Mới Dữ Liệu" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- TẦNG 1: 4 THẺ KPI TỨC THỜI (HÀNG NGANG 25% MỖI Ô) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng Số Bản Sách -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BookMultiple" Width="14" Height="14" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="TỔNG SỐ BẢN SÁCH" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding KpiSummary.TotalBookCopies, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Gồm " /><Run Text="{Binding KpiSummary.TotalBookTitles, Mode=OneWay}" /><Run Text=" đầu sách trong kho" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Đang Cho Mượn -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BookArrowRight" Width="14" Height="14" Foreground="{StaticResource BrandPinkBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="ĐANG CHO MƯỢN" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding KpiSummary.BorrowingBooks, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" Margin="0,6,0,2" />
                        <TextBlock Text="Sách độc giả đang giữ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- KPI 3: Sách Quá Hạn -->
                <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClockAlertOutline" Width="14" Height="14" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="SÁCH QUÁ HẠN" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding KpiSummary.OverdueBooks, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,2" />
                        <TextBlock Text="Phiếu trễ hạn cần thu hồi gấp" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- KPI 4: Bạn Đọc Kích Hoạt -->
                <Border Grid.Column="6" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountCheckOutline" Width="14" Height="14" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="BẠN ĐỌC KÍCH HOẠT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding KpiSummary.TotalMembers, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,2" />
                        <TextBlock Text="Tài khoản đang hoạt động" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TẦNG 2: BIỂU ĐỒ XU HƯỚNG MƯỢN & TRẢ SÁCH (7 NGÀY GẦN NHẤT) CHUẨN XỊN -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <!-- Header của biểu đồ kèm Legend -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ChartBar" Width="18" Height="18" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Xu Hướng Mượn - Trả Sách (7 Ngày Gần Nhất)" 
                                       FontSize="14.5" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chú giải Legend (Góc Phải) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <Border Width="12" Height="12" Background="#4F46E5" CornerRadius="3" Margin="0,0,6,0" />
                                <TextBlock Text="Lượt Mượn" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="12" Height="12" Background="#EC4899" CornerRadius="3" Margin="0,0,6,0" />
                                <TextBlock Text="Lượt Trả" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- VÙNG BIỂU ĐỒ LIVECHARTS CARTESIAN ĐỘNG TỪ CSDL -->
                    <Grid Margin="0,5,0,0">
                        <lvc:CartesianChart Height="180" 
                                            Series="{Binding TrendSeriesCollection}" 
                                            LegendLocation="None"
                                            Hoverable="True">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding TrendLabels}" 
                                          Foreground="#64748B" 
                                          FontSize="12" 
                                          FontWeight="SemiBold">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" IsEnabled="False" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding YFormatter}" 
                                          MinValue="0" 
                                          Foreground="#94A3B8" 
                                          FontSize="11">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Stroke="#E2E8F0" StrokeDashArray="4 2" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TẦNG 3: TỶ LỆ 7.5 (QUÁ HẠN THU HỒI) : 4.5 (TOP 5 SÁCH MƯỢN NHIỀU NHẤT) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7.5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="4.5*" />
                </Grid.ColumnDefinitions>

                <!-- Cột Trái (7.5): Sách quá hạn cần thu hồi gấp -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="SÁCH QUÁ HẠN CẦN THU HỒI GẤP" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <DataGrid ItemsSource="{Binding OverdueBorrows}" 
                                  Style="{StaticResource ModernDataGrid}" 
                                  Height="280" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding SlipCode}" Width="120">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="Độc Giả" Binding="{Binding MemberFullName}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding MemberFullName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="Tên Sách" Binding="{Binding BookTitle}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding BookTitle}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="Hẹn Trả" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="95">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTemplateColumn Header="Trễ Hạn" Width="85">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OverdueDays, StringFormat={}{0} ngày}" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" FontSize="11.5" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="SĐT Liên Hệ" Binding="{Binding PhoneNumber}" Width="105">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Cột Phải (4.5): Top 5 đầu sách mượn nhiều nhất dạng List 1, 2, 3, 4, 5 -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <iconPacks:PackIconMaterial Kind="TrophyOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="TOP 5 ĐẦU SÁCH MƯỢN NHIỀU" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding TopBooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10,8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Badge Thứ hạng 1, 2, 3, 4, 5 -->
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Rank}" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Tên sách & Thể loại -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BookTitle}" />
                                                <TextBlock Text="{Binding CategoryName}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryName}" />
                                            </StackPanel>

                                            <!-- Số lượt mượn -->
                                            <Border Grid.Column="2" Background="{StaticResource HoverPastelBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BorrowCount, StringFormat={}{0} lượt}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandPinkBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TẦNG 4: YÊU CẦU CHỜ DUYỆT VÀ NHẬT KÝ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cột Trái: Yêu cầu chờ duyệt từ độc giả -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <iconPacks:PackIconMaterial Kind="ClockOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="YÊU CẦU CHỜ DUYỆT TỪ ĐỘC GIẢ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <DataGrid ItemsSource="{Binding PendingRequests}" 
                                  Style="{StaticResource ModernDataGrid}" 
                                  Height="220" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestId, StringFormat=RQ{0}}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Độc Giả" Binding="{Binding MemberFullName}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding MemberFullName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Loại Yêu Cầu" Binding="{Binding RequestTypeDisplay}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding RequestTypeDisplay}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Thời Gian" Binding="{Binding CreatedAt, StringFormat=HH:mm dd/MM}" Width="100">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="140">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding StatusDisplay}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Cột Phải: Nhật ký hoạt động -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <iconPacks:PackIconMaterial Kind="FlashOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG GẦN ĐÂY" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <DataGrid ItemsSource="{Binding RecentActivities}" 
                                  Style="{StaticResource ModernDataGrid}" 
                                  Height="220" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời Gian" Binding="{Binding FormattedTime}" Width="105">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Loại" Binding="{Binding ActivityType}" Width="85" FontWeight="SemiBold">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Độc Giả" Binding="{Binding MemberName}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding MemberName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tên Sách" Binding="{Binding BookTitle}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding BookTitle}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Người Xử Lý" Binding="{Binding HandledBy}" Width="150">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding HandledBy}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TẦNG 5: TOP ĐỘC GIẢ NĂNG NỔ MƯỢN SÁCH NHIỀU NHẤT (FULL WIDTH) -->
            <Border Style="{StaticResource ModernCard}" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="StarOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="TOP ĐỘC GIẢ NĂNG NỔ MƯỢN SÁCH NHIỀU NHẤT THƯ VIỆN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <DataGrid ItemsSource="{Binding TopMembers}" 
                              Style="{StaticResource ModernDataGrid}" 
                              Height="200" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vinh Danh" Binding="{Binding RankIcon}" Width="85">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>

                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mã Thẻ" Binding="{Binding MemberCardCode}" Width="150">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Họ và Tên Độc Giả" Binding="{Binding FullName}" Width="320">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding FullName}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Liên Hệ (Email / SĐT)" Binding="{Binding EmailOrPhone}" Width="*" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding EmailOrPhone}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng Mượn" Binding="{Binding TotalBorrowCount, StringFormat={}{0} cuốn}" Width="140">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đang Giữ" Binding="{Binding ActiveBorrowCount, StringFormat={}{0} cuốn}" Width="140">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
