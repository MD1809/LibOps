<Window x:Class="LibOps.PresentationLayer.Views.Payment.VietQRQuickPayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="CỔNG THANH TOÁN TỰ ĐỘNG VIETQR PAYOS" 
        Height="640" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Gradient Xanh VietQR -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.5"/>
                        <GradientStop Color="#0284C7" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="QrcodeScan" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CỔNG THANH TOÁN TỰ ĐỘNG" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Quét mã VietQR bằng ứng dụng Ngân hàng bất kỳ" FontSize="11.5" Foreground="#BAE6FD" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Nút đóng nhanh góc phải -->
                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Thân cửa sổ: Mã QR & Thông tin chuyển khoản -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Trạng thái Thành công (Chuyển xanh khi nhận được tiền) -->
                    <Border Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Width="380">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Khung Đếm Ngược & Trạng thái Đang Chờ -->
                    <Border Visibility="{Binding IsSuccess, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClockOutline" Width="15" Height="15" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thời gian giữ mã: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CountdownText}" FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Khung chứa ảnh mã QR -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="12" Width="230" Height="230" HorizontalAlignment="Center" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <!-- Vòng xoay khi đang nạp ảnh -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="Loading" Width="36" Height="36" Foreground="#0284C7" Spin="True" HorizontalAlignment="Center"/>
                                <TextBlock Text="Đang tạo mã VietQR..." FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Ảnh QR Code sắc nét -->
                            <Image Source="{Binding QrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Dòng trạng thái Radar nhấp nháy -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0284C7" 
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,12" TextWrapping="Wrap"/>

                    <!-- Bảng thông tin chuyển khoản rõ ràng -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Width="380">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Số tiền -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Số tiền nạp:" FontSize="12" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PaymentOrder.Amount, StringFormat={}{0:N0} VNĐ}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,2"/>

                            <!-- Ngân hàng -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngân hàng:" FontSize="12" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaymentOrder.BankName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2"/>

                            <!-- Số tài khoản -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Số tài khoản:" FontSize="12" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PaymentOrder.AccountNumber}" FontSize="12.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,2"/>

                            <!-- Chủ tài khoản -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Chủ tài khoản:" FontSize="12" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PaymentOrder.AccountName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2"/>

                            <!-- Nội dung chuyển khoản -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Nội dung CK:" FontSize="12" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PaymentOrder.Description}" FontSize="12.5" FontWeight="Bold" Foreground="#DC2626" Margin="0,2"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Buttons -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,15,15" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút Test nhanh: Mô phỏng đã thanh toán -->
                    <Button Grid.Column="0" Command="{Binding SimulateSuccessCommand}" Style="{StaticResource OutlineButton}" Height="34" HorizontalAlignment="Left" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="LightningBolt" Width="13" Height="13" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Mô Phỏng Thanh Toán" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Hủy / Đóng -->
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Đóng" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
