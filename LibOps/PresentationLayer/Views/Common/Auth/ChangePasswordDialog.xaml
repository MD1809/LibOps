<Window x:Class="LibOps.PresentationLayer.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="ĐỔI MẬT KHẨU TÀI KHOẢN"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="ĐỔI MẬT KHẨU TÀI KHOẢN" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Form nhập liệu -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20">
            <StackPanel>
                
                <!-- Thông báo lỗi nếu có -->
                <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Mật khẩu hiện tại -->
                <TextBlock Text="Mật Khẩu Hiện Tại (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PbCurrent" PasswordChar="*" Style="{StaticResource ModernPasswordBox}" Tag="Mật Khẩu Hiện Tại" Height="36" Margin="0,0,0,12" PasswordChanged="PbCurrent_PasswordChanged" />

                <!-- Mật khẩu mới -->
                <TextBlock Text="Mật Khẩu Mới (Tối thiểu 6 ký tự) (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PbNew" PasswordChar="*" Style="{StaticResource ModernPasswordBox}" Tag="Mật Khẩu Mới" Height="36" Margin="0,0,0,12" PasswordChanged="PbNew_PasswordChanged" />

                <!-- Xác nhận mật khẩu mới -->
                <TextBlock Text="Xác Nhận Mật Khẩu Mới (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PbConfirm" PasswordChar="*" Style="{StaticResource ModernPasswordBox}" Tag="Xác Nhận Mật Khẩu Mới" Height="36" PasswordChanged="PbConfirm_PasswordChanged" />

            </StackPanel>
        </Border>

        <!-- Nút thao tác dưới đáy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource OutlineButton}" Width="130" Height="38" Margin="0,0,10,0" Click="BtnCancel_Click" IsCancel="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Hủy Bỏ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryGradientButton}" Width="160" Height="38" Command="{Binding SaveCommand}" IsDefault="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Lưu Mật Khẩu" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
