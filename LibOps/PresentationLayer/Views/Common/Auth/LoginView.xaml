<Window x:Class="LibOps.PresentationLayer.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="LibOps - Đăng Nhập Hệ Thống"
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <!-- Card trung tâm -->
        <Border Width="390" Height="500"
                Background="White"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                Effect="{StaticResource FloatingShadow}"
                Padding="32,28">
            
            <StackPanel VerticalAlignment="Center">
                <!-- Logo & Brand Header -->
                <iconPacks:PackIconMaterial Kind="BookOpenPageVariant" Width="36" Height="36" Foreground="{StaticResource PrimaryGradientBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="LIBOPS"
                           FontSize="28"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource PrimaryGradientBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2" />

                <TextBlock Text="Hệ Thống Quản Lý Thư Viện Hiện Đại"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <!-- Banner Thông báo lỗi -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <iconPacks:PackIconMaterial Kind="AlertCircleOutline" 
                                Width="16" Height="16" 
                                Foreground="#DC2626" 
                                VerticalAlignment="Center" 
                                Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                        Foreground="#DC2626"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        MaxWidth="300" />
                </StackPanel>

                <!-- Input: Username -->
                <TextBlock Text="Tên đăng nhập *"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                
                <TextBox x:Name="txtUsername"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Tag="Nhập tên đăng nhập"
                         Height="40"
                         Margin="0,0,0,16" />

                <!-- Input: Password -->
                <TextBlock Text="Mật khẩu *"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />

                <PasswordBox x:Name="pwdPassword"
                             PasswordChar="*"
                             Style="{StaticResource ModernPasswordBox}"
                             Tag="Nhập mật khẩu"
                             Height="40"
                             Margin="0,0,0,24"
                             KeyDown="PwdPassword_KeyDown" />

                <!-- Nút Đăng Nhập -->
                <Button Style="{StaticResource PrimaryGradientButton}"
                        Height="44"
                        Margin="0,0,0,12"
                        Click="BtnLogin_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Login" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LoginButtonText}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Nút Thoát -->
                <Button Style="{StaticResource OutlineButton}"
                        Height="38"
                        Command="{Binding CloseCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Thoát Ứng Dụng" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
