<UserControl x:Class="LibOps.PresentationLayer.Views.StaffManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LibOps.PresentationLayer.ViewModels"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:StaffManagementViewModel}"
             d:DesignHeight="650" d:DesignWidth="1000">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ TÀI KHOẢN VÀ PHÂN QUYỀN NHÂN VIÊN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Danh sách người dùng, vai trò quản trị (Admin / Librarian) và quản lý bảo mật mật khẩu" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding AddUserCommand}" Style="{StaticResource PrimaryGradientButton}" Margin="0,0,8,0" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountPlus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm Nhân Viên" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Tải Lại" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search & Actions Bar -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBox Style="{StaticResource ModernTextBox}" 
                             Tag="Tìm theo tên đăng nhập, họ tên, vai trò..."
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Width="340" Height="36" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding EditUserCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Padding="14,0" Height="36">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountEdit" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Sửa Thông Tin" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{Binding ToggleLockCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Padding="14,0" Height="36">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountLockOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ToggleLockLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{Binding ResetPasswordCommand}" Style="{StaticResource DangerButton}" Padding="14,0" Height="36">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="LockReset" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Reset Mật Khẩu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Users Grid -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          Style="{StaticResource ModernDataGrid}" 
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã NV" Binding="{Binding UserId}" Width="80"/>
                        <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding Username}" FontWeight="Bold" Width="150"/>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="180"/>
                        <DataGridTextColumn Header="Vai Trò" Binding="{Binding RoleName}" FontWeight="SemiBold" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="130"/>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveStatusConverter}}"
                                               Foreground="{Binding IsActive, Converter={StaticResource BoolToStatusBrushConverter}}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ngày Tạo" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationControl Grid.Row="1" DataContext="{Binding Paging}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
