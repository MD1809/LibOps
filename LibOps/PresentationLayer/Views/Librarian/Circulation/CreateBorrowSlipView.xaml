<UserControl x:Class="LibOps.PresentationLayer.Views.CreateBorrowSlipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LẬP PHIẾU MƯỢN SÁCH TẠI QUẦY" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Quá trình mượn sách nhanh chóng." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Khu vực 1: Quét mã thẻ & Thông tin độc giả -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Mã thẻ độc giả: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding MemberCardCode, UpdateSourceTrigger=PropertyChanged}" Tag="Nhập mã thẻ, SĐT, CCCD..." Height="36">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding CheckMemberCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Height="36" Command="{Binding CheckMemberCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Kiểm Tra" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Dải thông tin tóm tắt & Trạng thái điều kiện (Chia rõ ràng Cột trái: Độc giả - Cột phải: Trạng thái) -->
                <Border Grid.Row="1" Background="{StaticResource BgLightBrush}" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: Thông tin chi tiết độc giả & Các chỉ số tài chính -->
                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <!-- TH 1: Đã tìm thấy độc giả -->
                            <StackPanel Visibility="{Binding HasCurrentMember, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Dòng 1: Tên, Mã thẻ & SĐT -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <iconPacks:PackIconMaterial Kind="AccountCheck" Width="16" Height="16" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding MemberCardCodeDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" - " FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MemberFullNameDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" | SĐT: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding MemberPhoneDisplay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Dòng 2: Tiền cọc, Nợ phạt, Số lượng đang mượn -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tiền cọc: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DepositBalanceDisplay}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    
                                    <TextBlock Text="Nợ phạt: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalDebtDisplay}" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    
                                    <TextBlock Text="Đang mượn: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentBorrowCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="/3 cuốn" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- TH 2: Chưa chọn độc giả -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasCurrentMember, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="AccountSearchOutline" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Chưa chọn độc giả. Vui lòng nhập Mã thẻ, SĐT hoặc CCCD rồi nhấn Kiểm Tra (Enter)." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- CỘT PHẢI: Trạng thái điều kiện mượn sách ngắn gọn -->
                        <Border Grid.Column="1" 
                                Background="White" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderLightBrush}" 
                                CornerRadius="6" 
                                Padding="12,8" 
                                VerticalAlignment="Center"
                                ToolTip="{Binding EligibilityReason}"
                                Visibility="{Binding EligibilityMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding EligibilityMessage}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Khu vực 2: Quét mã vạch sách -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Nhập mã vạch sách: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding BookBarcode, UpdateSourceTrigger=PropertyChanged}" Tag="Quét mã vạch sách (Barcode)..." Height="36" IsEnabled="{Binding IsMemberEligible}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddBookCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Style="{StaticResource SuccessButton}" Margin="8,0,0,0" Height="36" Command="{Binding AddBookCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Thêm Vào Phiếu" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="3" Text="Hạn mức: Tối đa 3 cuốn/độc giả | Thời hạn mượn: 14 ngày" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Bảng danh sách sách chọn mượn -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding CartItems}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Vạch Sách" Binding="{Binding Barcode}" FontWeight="Bold" Width="150">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tên Tựa Đề Sách" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Thể Loại" Binding="{Binding CategoryName}" Width="140" />
                    <DataGridTextColumn Header="Vị Trí Kệ" Binding="{Binding ShelfLocation}" Width="120">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tình Trạng Ban Đầu" Binding="{Binding ConditionDisplay}" Width="180" />
                    <DataGridTemplateColumn Header="Thao Tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DangerButton}" Height="28" Padding="6,0"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Xóa" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer: Nút Xác nhận mượn -->
        <Border Grid.Row="4" Style="{StaticResource ModernCard}" Padding="16,12" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ghi chú phiếu: " VerticalAlignment="Center" />
                    <TextBox Text="{Binding BorrowNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Nhập ghi chú cho phiếu mượn..." Width="400" Height="36" Margin="8,0,0,0" />
                </StackPanel>

                <Button Style="{StaticResource PrimaryGradientButton}"
                        HorizontalAlignment="Right"
                        Height="40"
                        Command="{Binding ConfirmBorrowCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="XÁC NHẬN MƯỢN" VerticalAlignment="Center" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
