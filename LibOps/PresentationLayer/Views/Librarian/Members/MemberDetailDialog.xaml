<Window x:Class="LibOps.PresentationLayer.Views.MemberDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding DialogTitle}"
        Width="600" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Form nhập liệu -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- Thông báo lỗi nếu có -->
                    <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- Mã thẻ & Họ tên -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã Thẻ Thành Viên" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding MemberCardCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" IsReadOnly="{Binding IsMemberCardCodeReadOnly}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Họ Và Tên Độc Giả (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <!-- SĐT & Email -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số Điện Thoại (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Địa Chỉ Email" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <!-- Số CCCD/CMND & Ngày sinh -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số CCCD / CMND (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding IdentityCardNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ngày Sinh" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <DatePicker Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <!-- Địa chỉ liên hệ -->
                    <TextBlock Text="Địa Chỉ Thường Trú / Tạm Trú" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12" />

                    <!-- Phí làm thẻ & Tiền cọc mở thẻ (chỉ hiển thị khi thêm mới) -->
                    <StackPanel Visibility="{Binding IsNewMember, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 2 Cột: Phí phát hành thẻ & Tiền cọc thế chân nạp trước -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phí Phát Hành Thẻ (VNĐ) (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandIndigoBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CardIssuanceFee, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Style="{StaticResource ModernTextBox}" Height="36" IsReadOnly="True" Background="#F1F5F9" />
                                <TextBlock Text="Phí dịch vụ (Không hoàn lại)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nạp Ví Cọc Ban Đầu (VNĐ)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPinkBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding InitialDeposit, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Style="{StaticResource ModernTextBox}" Height="36" />
                                <TextBlock Text="Tiền cọc thế chân mượn sách" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Tổng tiền thu tại quầy -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng Tiền Thu Tại Quầy:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandIndigoBrush}" />
                                    <TextBlock Text="= Phí phát hành thẻ (50.000đ) + Tiền nạp ví cọc ban đầu" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TotalPaymentDue, StringFormat={}{0:N0} VNĐ}" FontWeight="Bold" FontSize="16" Foreground="#1E40AF" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Nút thao tác dưới đáy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource OutlineButton}" Width="120" Height="38" Margin="0,0,10,0" Click="BtnCancel_Click" IsCancel="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Hủy Bỏ" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryGradientButton}" Width="160" Height="38" Command="{Binding SaveCommand}" IsDefault="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Lưu Hồ Sơ" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
