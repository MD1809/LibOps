<Window x:Class="LibOps.PresentationLayer.Views.Members.MemberRenewCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="GIA HẠN THẺ ĐỘC GIẢ"
        Width="540" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <iconPacks:PackIconMaterial Kind="CalendarSyncOutline" Width="24" Height="24" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock Text="GIA HẠN THẺ ĐỘC GIẢ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" />
                <TextBlock Text="Thực hiện thanh toán phí thường niên để gia hạn thời hạn sử dụng thẻ (+1 năm)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Khung nội dung -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20">
            <StackPanel>
                
                <!-- Thông báo lỗi nếu có -->
                <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Thông tin độc giả & Hạn dùng -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MemberInfo.FullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding MemberInfo.MemberCardCode, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="12" />
                            </Border>
                        </Grid>

                        <Separator Background="{StaticResource BorderLightBrush}" Margin="0,2,0,8" />

                        <!-- So sánh hạn cũ -> hạn mới -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hạn dùng hiện tại:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CurrentExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                            <iconPacks:PackIconMaterial Grid.Column="1" Kind="ArrowRightBold" Width="16" Height="16" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="8,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hạn mới dự kiến (+1 năm):" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="13.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Số dư cọc hiện tại: " />
                                <Run Text="{Binding MemberInfo.DepositBalance, Mode=OneWay, StringFormat={}{0:N0} VNĐ}" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" />
                                <Run Text=" (Mức cọc tối thiểu duy trì: " />
                                <Run Text="{Binding MinDeposit, Mode=OneWay, StringFormat={}{0:N0} VNĐ}" FontWeight="SemiBold" />
                                <Run Text=")" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Phí thường niên gia hạn -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Phí Thường Niên Gia Hạn (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding RenewalFee, StringFormat={}{0:N0} VNĐ}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Phương thức thanh toán -->
                <TextBlock Text="Hình Thức Thanh Toán Phí" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding PaymentMethod, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}" Height="38" Margin="0,0,0,6">
                    <!-- Tùy chọn 1: Tiền mặt tại quầy (Chỉ hiển thị cho Thủ thư) -->
                    <ComboBoxItem Tag="CASH" Visibility="{Binding IsReaderMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cash" Width="15" Height="15" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="1. Tiền mặt tại quầy (CASH)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    
                    <!-- Tùy chọn 2: Quét mã VietQR PayOS (Khuyên dùng - Nhanh chóng & Tự động) -->
                    <ComboBoxItem Tag="BANK_TRANSFER">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="QrcodeScan" Width="15" Height="15" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Quét mã VietQR PayOS (Thanh toán trực tiếp 50k - Tự động)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    
                    <!-- Tùy chọn 3: Khấu trừ Quỹ cọc (Yêu cầu số dư >= 250k) -->
                    <ComboBoxItem Tag="DEDUCT_DEPOSIT" IsEnabled="{Binding CanDeductFromDeposit}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CreditCardCheckOutline" Width="15" Height="15" Foreground="{StaticResource BrandPinkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Khấu trừ từ Quỹ cọc thẻ (Yêu cầu số dư ≥ 250.000 VNĐ)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Gợi ý điều kiện trừ cọc -->
                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DeductDepositHint}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Ghi chú bổ sung -->
                <TextBlock Text="Ghi Chú Gia Hạn (Tùy chọn)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40" AcceptsReturn="True" TextWrapping="Wrap" />

            </StackPanel>
        </Border>

        <!-- Nút thao tác dưới đáy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource OutlineButton}" Width="120" Height="38" Margin="0,0,10,0" Click="BtnCancel_Click" IsCancel="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Đóng (Esc)" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryGradientButton}" Width="200" Height="38" Command="{Binding ConfirmRenewCommand}" IsDefault="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Tiến Hành Gia Hạn" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
