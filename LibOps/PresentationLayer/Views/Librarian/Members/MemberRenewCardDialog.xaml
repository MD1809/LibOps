<Window x:Class="LibOps.PresentationLayer.Views.Members.MemberRenewCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Gia hạn thẻ thư viện"
        Width="480" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#312E81" Offset="0.5"/>
                        <GradientStop Color="#4F46E5" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CalendarSyncOutline" Width="20" Height="20" Foreground="#C7D2FE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Gia hạn thẻ thư viện" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Gia hạn thời hạn sử dụng thẻ thêm 1 năm" FontSize="12" Foreground="#C7D2FE" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>
                    <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MemberInfo.FullName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding MemberInfo.MemberCardCode, Mode=OneWay}" FontWeight="SemiBold" Foreground="#4F46E5" FontSize="11.5" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hạn dùng hiện tại:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CurrentExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" Margin="0,2,0,0" />
                                </StackPanel>
                                <iconPacks:PackIconMaterial Grid.Column="1" Kind="ArrowRightThin" Width="15" Height="15" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="80,0,90,0" />
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Hạn mới sau gia hạn:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding NewExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="SemiBold" Foreground="#10B981" FontSize="12.5" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số dư tiền cọc hiện có:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding MemberInfo.DepositBalance, Mode=OneWay, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Phí thường niên:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding RenewalFee, StringFormat={}{0:N0} đ}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Hình thức thanh toán:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ComboBox SelectedValue="{Binding PaymentMethod, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,6">
                                <ComboBoxItem Tag="CASH" Visibility="{Binding IsReaderMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tiền mặt tại quầy" VerticalAlignment="Center" />
                                </ComboBoxItem>
                                
                                <ComboBoxItem Tag="BANK_TRANSFER">
                                    <TextBlock Text="Quét mã VietQR" VerticalAlignment="Center" />
                                </ComboBoxItem>
                                
                                <ComboBoxItem Tag="DEDUCT_DEPOSIT" IsEnabled="{Binding CanDeductFromDeposit}">
                                    <TextBlock Text="Trừ vào tiền cọc hiện có" VerticalAlignment="Center" />
                                </ComboBoxItem>
                            </ComboBox>

                            <TextBlock Text="{Binding DeductDepositHint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ghi chú (tùy chọn):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Nhập ghi chú gia hạn nếu có..." Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Height="36" Width="90" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Command="{Binding ConfirmRenewCommand}" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="18,0" IsDefault="True">
                        <TextBlock Text="Xác nhận gia hạn" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
