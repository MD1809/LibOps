<Window x:Class="LibOps.PresentationLayer.Views.Members.ExpiredDebtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LibOps.PresentationLayer.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ExpiredDebtViewModel}"
        Title="Đối Soát Và Cấn Trừ Nợ Thẻ Hết Hạn" 
        Height="700" Width="1140"
        MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Style cho KPI Card -->
        <Style x:Key="DialogKpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style căn lề ô DataGrid -->
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. HEADER VÀ NÚT TÁC VỤ                                  -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ĐỐI SOÁT VÀ CẤN TRỪ NỢ PHẠT THẺ HẾT HẠN" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Kiểm tra thẻ độc giả đã hết hạn sử dụng, đối soát công nợ và tự động cấn trừ vào quỹ ký quỹ" 
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Nút Cấn Trừ Tất Cả -->
                <Button Command="{Binding SettleAllCommand}" 
                        Style="{StaticResource DangerButton}" 
                        Height="38" 
                        Padding="14,0" 
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Flash" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Cấn Trừ Hàng Loạt" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Nút Làm Mới -->
                <Button Command="{Binding RefreshCommand}" 
                        Style="{StaticResource OutlineButton}" 
                        Height="38" 
                        Padding="12,0"
                        ToolTip="Tải lại danh sách">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Làm Mới" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. 3 THẺ KPI TÓM TẮT CÔNG NỢ                             -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Số thẻ hết hạn còn nợ -->
            <Border Grid.Column="0" Style="{StaticResource DialogKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG THẺ HẾT HẠN CÒN NỢ" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalExpiredCount, StringFormat={}{0:N0} Thẻ}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,1"/>
                        <TextBlock Text="Độc giả quá hạn thẻ chưa thanh toán" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#FEF2F2" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountAlertOutline" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Tổng tiền nợ phạt đọng -->
            <Border Grid.Column="2" Style="{StaticResource DialogKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG NỢ PHẠT TỒN ĐỌNG" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalDebtAmount, StringFormat={}{0:N0} VNĐ}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,1"/>
                        <TextBlock Text="Phạt trễ hạn &amp; bồi thường chưa thu" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#FFFBEB" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Tiền cấn trừ khả dụng -->
            <Border Grid.Column="4" Style="{StaticResource DialogKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CẤN TRỪ KHẢ DỤNG (HỢP LỆ)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalPossibleSettlement, StringFormat={}{0:N0} VNĐ}" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,3,0,1"/>
                        <TextBlock Text="Đã trả hết sách, cấn trừ vào cọc" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#E0F2FE" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CashCheck" Width="20" Height="20" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. THANH TÌM KIẾM & BỘ LỌC TRẠNG THÁI                    -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tìm Kiếm -->
                <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Tìm kiếm:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Width="300" 
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Tìm theo mã thẻ, họ tên, số điện thoại..."
                         Height="38" 
                         FontSize="12"/>

                <!-- Lọc Theo Điều Kiện -->
                <TextBlock Text="Trạng thái:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="20,0,8,0"/>
                <ComboBox Width="240" Height="38"
                          SelectedValue="{Binding SelectedFilterStatus, Mode=TwoWay}" 
                          SelectedValuePath="Tag" 
                          FontSize="12">
                    <ComboBoxItem Content="-- Tất cả độc giả hết hạn --" Tag="ALL" IsSelected="True"/>
                    <ComboBoxItem Content="Đủ điều kiện cấn trừ nợ" Tag="ELIGIBLE"/>
                    <ComboBoxItem Content="Đang giữ sách (Khóa cấn trừ)" Tag="BORROWING"/>
                    <ComboBoxItem Content="Hết tiền cọc (Số dư = 0)" Tag="NO_DEPOSIT"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. BẢNG DANH SÁCH ĐỐI SOÁT                               -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Debtors}" 
                      SelectedItem="{Binding SelectedDebtor}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- STT -->
                    <DataGridTextColumn Header="STT" Binding="{Binding SequenceNumber}" Width="45" ElementStyle="{StaticResource CenterAlignedCell}"/>

                    <!-- Mã Thẻ -->
                    <DataGridTextColumn Header="Mã Thẻ" Binding="{Binding MemberCardCode}" Width="110" FontWeight="Bold" ElementStyle="{StaticResource CenterAlignedCell}"/>

                    <!-- Họ Và Tên + SĐT -->
                    <DataGridTemplateColumn Header="Họ Và Tên Độc Giả" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PhoneNumber}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Hạn Dùng Thẻ -->
                    <DataGridTemplateColumn Header="Hạn Thẻ / Quá Hạn" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding OverdueDays, StringFormat={}Quá {0} ngày}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SÁCH ĐANG GIỮ (Badge cảnh báo) -->
                    <DataGridTemplateColumn Header="Sách Đang Giữ" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border CornerRadius="4" Padding="8,3" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentlyBorrowingCount}" Value="0">
                                                        <Setter Property="Background" Value="#F0F9FF"/>
                                                        <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CurrentlyBorrowingCount, StringFormat={}{0} cuốn}" FontWeight="Bold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentlyBorrowingCount}" Value="0">
                                                            <Setter Property="Foreground" Value="#0284C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NỢ PHẠT -->
                    <DataGridTextColumn Header="Nợ Phạt" Binding="{Binding TotalDebt, StringFormat={}{0:N0} đ}" Width="110" FontWeight="Bold" Foreground="#DC2626" ElementStyle="{StaticResource RightAlignedCell}"/>

                    <!-- TIỀN CỌC HIỆN TẠI -->
                    <DataGridTextColumn Header="Tiền Cọc" Binding="{Binding DepositBalance, StringFormat={}{0:N0} đ}" Width="110" FontWeight="SemiBold" Foreground="#4338CA" ElementStyle="{StaticResource RightAlignedCell}"/>

                    <!-- SỐ TIỀN CẤN TRỪ -->
                    <DataGridTextColumn Header="Cấn Trừ Dự Kiến" Binding="{Binding SettlementAmount, StringFormat={}{0:N0} đ}" Width="125" FontWeight="Bold" Foreground="#0284C7" ElementStyle="{StaticResource RightAlignedCell}"/>

                    <!-- CỌC CÒN LẠI -->
                    <DataGridTextColumn Header="Cọc Còn Lại" Binding="{Binding RemainingDepositAfterSettlement, StringFormat={}{0:N0} đ}" Width="110" ElementStyle="{StaticResource RightAlignedCell}"/>

                    <!-- NÚT THAO TÁC -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="{Binding ActionTooltip}"
                                        IsEnabled="{Binding CanSettleDebt}"
                                        Command="{Binding DataContext.SettleSingleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Height="30" Margin="4,0"
                                        Focusable="False">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="btnBorder" 
                                                                Background="#0284C7" 
                                                                BorderBrush="#0369A1" 
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="8,0">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <iconPacks:PackIconMaterial x:Name="btnIcon" Kind="ScaleBalance" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock x:Name="btnText" Text="{Binding ActionButtonText}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                            <!-- Khi đang giữ sách (Khóa cấn trừ) -> Màu đỏ nhạt pastel, chữ và icon đỏ rõ nét -->
                                                            <DataTrigger Binding="{Binding IsBorrowingLockout}" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#FEF2F2"/>
                                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FECACA"/>
                                                                <Setter TargetName="btnIcon" Property="Kind" Value="LockOutline"/>
                                                                <Setter TargetName="btnIcon" Property="Foreground" Value="#DC2626"/>
                                                                <Setter TargetName="btnText" Property="Foreground" Value="#DC2626"/>
                                                                <Setter Property="Cursor" Value="No"/>
                                                            </DataTrigger>
                                                            <!-- Khi hết tiền cọc -> Màu xám nhạt pastel -->
                                                            <DataTrigger Binding="{Binding DepositBalance}" Value="0">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                                <Setter TargetName="btnIcon" Property="Kind" Value="AlertCircleOutline"/>
                                                                <Setter TargetName="btnIcon" Property="Foreground" Value="#94A3B8"/>
                                                                <Setter TargetName="btnText" Property="Foreground" Value="#64748B"/>
                                                                <Setter Property="Cursor" Value="No"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
