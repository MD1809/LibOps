<Window x:Class="LibOps.PresentationLayer.Views.MemberDepositDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="NẠP TIỀN KÝ QUỸ ĐỘC GIẢ"
        Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="NẠP TIỀN KÝ QUỸ ĐỘC GIẢ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Form nhập liệu -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20">
            <StackPanel>
                
                <!-- Thông báo lỗi nếu có -->
                <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Thông tin độc giả -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding MemberInfo.FullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                            <Run Text="Mã thẻ: " /><Run Text="{Binding MemberInfo.MemberCardCode, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" | Số dư hiện tại: " /><Run Text="{Binding MemberInfo.DepositBalance, Mode=OneWay, StringFormat={}{0:N0} VNĐ}" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Số tiền nạp thêm -->
                <TextBlock Text="Số Tiền Nạp Thêm (VNĐ) (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12" />

                <!-- Phương thức thanh toán -->
                <TextBlock Text="Hình Thức Thanh Toán" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <ComboBox SelectedValue="{Binding PaymentMethod, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,12">
                    <ComboBoxItem Tag="CASH" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cash" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Tiền mặt tại quầy (CASH)" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="BANK_TRANSFER">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BankOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Chuyển khoản QR (BANK_TRANSFER)" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Ghi chú -->
                <TextBlock Text="Ghi Chú Nạp Tiền" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />

            </StackPanel>
        </Border>

        <!-- Nút thao tác dưới đáy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource OutlineButton}" Width="120" Height="38" Margin="0,0,10,0" Click="BtnCancel_Click" IsCancel="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Hủy Bỏ (Esc)" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryGradientButton}" Width="180" Height="38" Command="{Binding ConfirmDepositCommand}" IsDefault="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CashPlus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Xác Nhận Nạp Cọc" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
