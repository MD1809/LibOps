<Window x:Class="LibOps.PresentationLayer.Views.Members.MemberReactivateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TÁI CẤP THẺ ĐỘC GIẢ"
        Width="540" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <iconPacks:PackIconMaterial Kind="CardAccountDetailsOutline" Width="24" Height="24" Foreground="{StaticResource BrandIndigoBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock Text="TÁI CẤP THẺ ĐỘC GIẢ (RE-ACTIVATE)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" />
                <TextBlock Text="Kích hoạt lại hồ sơ thẻ đã hủy, nộp phí phát hành và tiền cọc để tiếp tục mượn sách" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Khung nội dung -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20">
            <StackPanel>
                
                <!-- Thông báo lỗi nếu có -->
                <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Thông tin độc giả -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MemberInfo.FullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="Đã hủy thẻ" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" FontSize="11.5" />
                            </Border>
                        </Grid>

                        <Separator Background="{StaticResource BorderLightBrush}" Margin="0,2,0,8" />

                        <!-- Mã thẻ & CCCD -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mã thẻ độc giả:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MemberInfo.MemberCardCode}" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Số CCCD/CMND:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MemberInfo.IdentityCardNumber}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Thời hạn thẻ mới sau khi kích hoạt -->
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Thời hạn thẻ mới (1 năm):" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NewExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Bold" Foreground="#059669" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Các khoản phí & Tiền cọc mới -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phí Phát Hành Lại (VNĐ) (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CardIssuanceFee, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Style="{StaticResource ModernTextBox}" Height="36" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tiền Cọc Thế Chân Mới (VNĐ) (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding InitialDeposit, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Style="{StaticResource ModernTextBox}" Height="36" />
                    </StackPanel>
                </Grid>

                <!-- Tổng tiền phải thu -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="Tổng tiền thực thu tại quầy:" FontWeight="SemiBold" FontSize="13" Foreground="#166534" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalPaymentRequired, StringFormat={}{0:N0} VNĐ}" FontWeight="Bold" FontSize="16" Foreground="#15803D" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nút hành động Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Style="{StaticResource OutlineButton}" Width="110" Height="36" HorizontalAlignment="Left" Command="{Binding CancelCommand}">
                <TextBlock Text="Hủy Bỏ" />
            </Button>

            <Button Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="20,0" HorizontalAlignment="Right" Command="{Binding ReactivateCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Xác Nhận Tái Cấp Thẻ (F5)" VerticalAlignment="Center" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
