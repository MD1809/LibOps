<UserControl x:Class="LibOps.PresentationLayer.Views.MemberListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Nút đăng ký mới / tải lại & Quỹ tiền cọc -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ ĐỘC GIẢ VÀ THẺ THƯ VIỆN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Cấp thẻ mới, quản lý tiền ký quỹ, gia hạn hạn dùng và kiểm soát trạng thái mượn sách" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryGradientButton}" Margin="0,0,8,0" Height="36" Command="{Binding AddMemberCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountPlusOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Đăng Ký Độc Giả" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                
                <Button Style="{StaticResource OutlineButton}" Height="36" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Tải Lại" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- KHỐI 1: Tìm kiếm & Lọc trạng thái (Phong cách tương tự trang danh mục sách) -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tìm kiếm -->
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Tìm kiếm theo mã thẻ, họ tên, SĐT, CCCD..." 
                         Width="320" Height="38" Margin="0,0,24,0" />

                <!-- Lọc Trạng Thái -->
                <TextBlock Text="Lọc Trạng Thái:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                <ComboBox SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                          Height="38" 
                          Width="240">
                    <ComboBoxItem Content="-- Tất cả trạng thái --" Tag="ALL" IsSelected="True" />
                    <ComboBoxItem Content="Đang hoạt động" Tag="ACTIVE" />
                    <ComboBoxItem Content="Tạm khóa" Tag="LOCKED" />
                    <ComboBoxItem Content="Đã hủy" Tag="CLOSED" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- KHỐI 2: Khối chức năng / Thao tác nghiệp vụ riêng biệt nằm dưới Tìm kiếm & Lọc -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
                <!-- Nhãn tiêu đề cụm nút chức năng -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <iconPacks:PackIconMaterial Kind="FlashOutline" Width="15" Height="15" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Thao tác với thẻ của độc giả:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Dải nút thao tác (Nằm dưới tiêu đề) -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,12,0" Command="{Binding EditMemberCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Sửa Hồ Sơ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,12,0" Command="{Binding RenewCardCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CalendarClock" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Gia Hạn Thẻ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,12,0" Command="{Binding ReactivateCardCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CardAccountDetailsOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Tái Cấp Thẻ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SuccessButton}" Height="36" Padding="14,0" Margin="0,0,12,0" Command="{Binding DepositCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CashPlus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Nạp Tiền Cọc" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,12,0" Command="{Binding ToggleLockCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="LockOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ToggleLockLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DangerButton}" Height="36" Padding="14,0" Command="{Binding CloseCardCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="AccountCancelOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Hủy Thẻ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- KHỐI 3: Bảng danh sách 8 cột chuẩn hóa -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Members}"
                          SelectedItem="{Binding SelectedMember}"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- Mã Thẻ -->
                        <DataGridTextColumn Header="Mã Thẻ" Binding="{Binding MemberCardCode}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Họ Và Tên -->
                        <DataGridTextColumn Header="Họ Và Tên" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="Padding" Value="10,0,0,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Số Điện Thoại -->
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- CCCD / CMND -->
                        <DataGridTextColumn Header="CCCD / CMND" Binding="{Binding IdentityCardNumber}" Width="140">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tiền Cọc -->
                        <DataGridTextColumn Header="Tiền Cọc" Binding="{Binding DepositBalanceFormatted}" Width="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,10,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Nợ Phạt -->
                        <DataGridTextColumn Header="Nợ Phạt" Binding="{Binding TotalDebtFormatted}" Width="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,10,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Hạn Thẻ -->
                        <DataGridTextColumn Header="Hạn Thẻ" Binding="{Binding ExpiryDateFormatted}" Width="110">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Trạng Thái -->
                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding CardStatusDisplay}" Width="140">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationControl Grid.Row="1" DataContext="{Binding Paging}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
