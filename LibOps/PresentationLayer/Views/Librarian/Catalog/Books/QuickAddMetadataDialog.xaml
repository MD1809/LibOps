<Window x:Class="LibOps.PresentationLayer.Views.QuickAddMetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding DialogTitle}"
        Width="460" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Width="20" Height="20" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding DialogTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Form nhập liệu -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <!-- Thông báo lỗi nếu có -->
                <Border Background="#FEE2E2" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Ô nhập chính -->
                <TextBlock Text="{Binding FieldLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding PrimaryValue, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Nhập thông tin tại đây..."
                         Height="36" Margin="0,0,0,12" />

                <!-- Ô nhập phụ (mô tả / ghi chú) -->
                <StackPanel Visibility="{Binding HasSecondaryField, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SecondaryLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SecondaryValue, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" 
                             Tag="Nhập ghi chú thêm (nếu có)..."
                             Height="36" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Nút hành động Lưu / Đóng -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource OutlineButton}" Width="100" Height="36" Margin="0,0,10,0" Click="CloseButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Đóng" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource PrimaryGradientButton}" Width="130" Height="36" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Lưu &amp; Chọn" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
