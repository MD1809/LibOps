<Window x:Class="LibOps.PresentationLayer.Views.BookDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Thông Tin Chi Tiết Đầu Sách"
        Width="880" Height="730"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="600" MinWidth="750"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ DIALOG -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EEF2FF" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                    <iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline" Width="20" Height="20" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="THÔNG TIN CHI TIẾT ĐẦU SÁCH" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Xem chi tiết nội dung, thông số phân loại và danh sách bản sao vật lý" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. THÂN NỘI DUNG (CARD CHÍNH) -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: ẢNH BÌA & THÔNG SỐ TỒN KHO -->
                <StackPanel Grid.Column="0">
                    <!-- Khung ảnh bìa -->
                    <Border CornerRadius="8" Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Height="290" Effect="{StaticResource CardShadow}" SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid>
                            <!-- Ảnh bìa thực tế -->
                            <Image Source="{Binding Book.CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"
                                   Visibility="{Binding HasCoverImage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Placeholder khi không có ảnh -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="BookOpenVariant" Width="52" Height="52" Foreground="{StaticResource SlateMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Không có ảnh bìa" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Khối thông số nhanh dưới ảnh -->
                    <Border Margin="0,14,0,0" Padding="14,12" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Giá bìa:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FormattedPrice}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandIndigoBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tổng bản sao:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Book.TotalQuantity, StringFormat='{}{0} cuốn'}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Khả dụng:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Book.AvailableQuantity, StringFormat='{}{0} cuốn'}" FontWeight="Bold" FontSize="12.5" Foreground="#059669" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CỘT PHẢI: CHI TIẾT & DANH SÁCH BẢN SAO -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tên sách & Tác giả -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Book.Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Book.AuthorName, StringFormat='Tác giả: {0}'}" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Bảng thông số 3 cột x 2 hàng -->
                    <Border Grid.Row="1" Background="#F0F7FF" BorderBrush="#E0EEFF" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hàng 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Thể loại:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Book.CategoryName}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                                <TextBlock Text="Nhà xuất bản:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Book.PublisherName, FallbackValue='—'}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="Năm xuất bản:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Book.PublishYear, FallbackValue='—'}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Hàng 2 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Mã ISBN:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Book.ISBN, FallbackValue='—'}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Trạng thái:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding AvailabilityDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="#059669" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Vị trí kệ:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Book.ShelfLocation, FallbackValue='Chưa xếp'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Khối tóm tắt nội dung -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Tóm tắt nội dung:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <Border Background="#FAFCFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding Book.Summary, FallbackValue='Chưa có tóm tắt nội dung cho tài liệu này.'}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Danh sách bản sao vật lý -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Danh sách bản sao vật lý &amp; Mã Barcode:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />

                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <DataGrid ItemsSource="{Binding Copies}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Bản Sao" Binding="{Binding CopyCode}" Width="100" />
                                    <DataGridTextColumn Header="Mã Barcode" Binding="{Binding Barcode}" Width="150" />
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColorBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Tình Trạng Sách" Binding="{Binding ConditionNote}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. THANH CÔNG CỤ CHÂN TRANG (FOOTER) -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource OutlineButton}" Height="36" Padding="16,0" Margin="0,0,10,0" Command="{Binding EditBookCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Chỉnh Sửa Sách" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SuccessButton}" Height="36" Padding="16,0" Command="{Binding ManageCopiesCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="BarcodeScan" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Bản Sao &amp; Barcode" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="20,0" Command="{Binding CloseCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Đóng" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
