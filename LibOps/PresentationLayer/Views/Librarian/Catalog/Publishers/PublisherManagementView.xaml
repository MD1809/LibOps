<UserControl x:Class="LibOps.PresentationLayer.Views.PublisherManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề phân hệ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="QUẢN LÝ NHÀ XUẤT BẢN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Quản lý danh sách nhà phát hành, đơn vị xuất bản và nhà cung ứng sách cho thư viện" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="36" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Tải Lại" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Layout 2 cột: Form nhập liệu & Danh sách DataGrid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Form nhập NXB -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="310" />
                        <RowDefinition Height="100" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Width="15" Height="15" Foreground="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="THÔNG TIN NHÀ XUẤT BẢN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="*Mã nhà xuất bản sẽ được thêm tự động" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Text="Tên Nhà Xuất Bản (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,4" />
                        <TextBox Text="{Binding PublisherName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Nhập tên nhà xuất bản tại đây" Height="36" Margin="0,0,0,14" />

                        <TextBlock Text="Địa Chỉ Trụ Sở" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PublisherAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Nhập địa chỉ trụ sở nhà xuất bản..." Height="36" Margin="0,0,0,14" />

                        <TextBlock Text="Số Điện Thoại Liên Hệ" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PublisherPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Nhập số điện thoại liên hệ..." Height="36" Margin="0,0,0,16" />
                    </StackPanel>

                    <!-- Nút thao tác -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DangerButton}" Height="36" Padding="14,0" Margin="0,0,8,0" Command="{Binding DeleteCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Xóa" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="16,0" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Lưu Dữ Liệu" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cột phải: Bảng danh sách NXB -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Hàng 0: Dành cho Tiêu đề & Thông báo -->
                        <RowDefinition Height="14" />
                        <!-- Khoảng cách hở giữa tiêu đề và bảng -->
                        <RowDefinition Height="*" />
                        <!-- Hàng 2: Dành cho DataGrid co giãn -->
                    </Grid.RowDefinitions>

                    <!-- HÀNG 0: Tiêu đề bên trái, Thông báo bên phải -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- Cột 0: Tiêu đề -->
                            <ColumnDefinition Width="*" />
                            <!-- Cột 1: Khoảng trống linh hoạt đẩy 2 đầu -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Cột 2: Thông báo trạng thái -->
                        </Grid.ColumnDefinitions>

                        <!-- 1. Tiêu đề (Nằm ở cột 0 - Bên trái) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ClipboardListOutline" Width="15" Height="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="DANH SÁCH NHÀ XUẤT BẢN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Thông báo trạng thái (Nằm ở cột 2 - Bên phải) -->
                        <Border Grid.Column="2" 
                                Background="#F1F5F9" 
                                CornerRadius="6" 
                                Padding="10,6" 
                                VerticalAlignment="Center"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkBrush}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <!-- HÀNG 2: Bảng DataGrid & Phân trang -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding Publishers}"
                                  SelectedItem="{Binding SelectedPublisher, Mode=TwoWay}"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã NXB" Binding="{Binding PublisherId, StringFormat=NXB{0:D2}}" Width="110">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tên Nhà Xuất Bản" Binding="{Binding PublisherName}" Width="230" FontWeight="SemiBold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="10,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding Address}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="10,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="150">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:PaginationControl Grid.Row="1" DataContext="{Binding Paging}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
