<UserControl x:Class="LibOps.PresentationLayer.Views.ReaderRequestListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LibOps.PresentationLayer.ViewModels"
             xmlns:controls="clr-namespace:LibOps.PresentationLayer.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReaderRequestListViewModel}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Style cho KPI Card -->
        <Style x:Key="RequestKpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style căn lề ô DataGrid -->
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Style căn lề Header DataGrid -->
        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. HEADER SECTION                                        -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TIẾP NHẬN VÀ XỬ LÝ YÊU CẦU ĐỘC GIẢ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Xét duyệt và xử lý các yêu cầu hủy thẻ, hoàn cọc, cấp lại thẻ và cập nhật thông tin bạn đọc" 
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" Height="38" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Làm Mới" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. THANH 4 THẺ KPI THỐNG KÊ NHANH                        -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Đang chờ duyệt -->
            <Border Grid.Column="0" Style="{StaticResource RequestKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ĐANG CHỜ DUYỆT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding PendingCount, StringFormat={}{0:N0} Yêu cầu}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,1"/>
                        <TextBlock Text="Cần tiếp nhận &amp; giải quyết" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#FFFBEB" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ClockOutline" Width="20" Height="20" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 2: Cần hoàn cọc -->
            <Border Grid.Column="2" Style="{StaticResource RequestKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CẦN HOÀN TIỀN CỌC" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding RefundCount, StringFormat={}{0:N0} Yêu cầu}" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,3,0,1"/>
                        <TextBlock Text="Yêu cầu rút tiền ký quỹ" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#E0F2FE" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="BankTransfer" Width="22" Height="22" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 3: Báo mất thẻ -->
            <Border Grid.Column="4" Style="{StaticResource RequestKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="BÁO MẤT CẦN CẤP THẺ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ReissueCount, StringFormat={}{0:N0} Yêu cầu}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,1"/>
                        <TextBlock Text="Thất lạc thẻ cần cấp lại" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#FEF2F2" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CardRemoveOutline" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 4: Đã phê duyệt -->
            <Border Grid.Column="6" Style="{StaticResource RequestKpiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ĐÃ PHÊ DUYỆT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ApprovedCount, StringFormat={}{0:N0} Yêu cầu}" FontSize="20" FontWeight="Bold" Foreground="#16A34A" Margin="0,3,0,1"/>
                        <TextBlock Text="Đã xử lý hoàn tất" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#F0FDF4" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. THANH CÔNG CỤ & BỘ LỌC ĐA TIÊU CHÍ                    -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. Ô tìm kiếm -->
                <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Tìm kiếm:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <Grid Width="280">
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" 
                             FontSize="12.5"
                             Padding="10,0,10,0" />
                    <TextBlock Text="Tìm mã YC, tên, mã thẻ..." IsHitTestVisible="False" 
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchKeyword}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 2. Lọc theo Loại yêu cầu -->
                <TextBlock Text="Loại yêu cầu:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="24,0,8,0"/>
                <ComboBox Width="210" Height="38"
                          SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}"
                          SelectedValuePath="Tag" 
                          FontSize="12.5">
                    <ComboBoxItem Tag="ALL" Content="-- Tất cả loại yêu cầu --" IsSelected="True" />
                    <ComboBoxItem Tag="CANCEL_CARD" Content="Hủy thẻ - Hoàn cọc" />
                    <ComboBoxItem Tag="REISSUE_CARD" Content="Báo mất thẻ" />
                    <ComboBoxItem Tag="UPDATE_INFO" Content="Cập nhật thông tin" />
                    <ComboBoxItem Tag="FEEDBACK_INQUIRY" Content="Góp ý và hỗ trợ" />
                </ComboBox>

                <!-- 3. Lọc theo Trạng thái -->
                <TextBlock Text="Trạng thái:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="24,0,8,0"/>
                <ComboBox Width="190" Height="38"
                          SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          SelectedValuePath="Tag" 
                          FontSize="12.5">
                    <ComboBoxItem Tag="ALL" Content="-- Tất cả trạng thái --" IsSelected="True" />
                    <ComboBoxItem Tag="PENDING" Content="Đang chờ duyệt" />
                    <ComboBoxItem Tag="APPROVED" Content="Đã phê duyệt" />
                    <ComboBoxItem Tag="REJECTED" Content="Đã từ chối" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. BẢNG DANH SÁCH YÊU CẦU TOÀN MÀN HÌNH                  -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          Style="{StaticResource ModernDataGrid}" 
                          ItemsSource="{Binding Requests}"
                          SelectedItem="{Binding SelectedRequest}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- 1. Mã Yêu Cầu (Căn giữa) -->
                        <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestCode}" FontWeight="Bold" Width="120" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 2. Mã Độc Giả (Căn giữa) -->
                        <DataGridTextColumn Header="Mã Thẻ / Độc Giả" Binding="{Binding MemberCardCode}" FontWeight="Bold" Width="140" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 3. Họ Và Tên Độc Giả (Căn trái) -->
                        <DataGridTextColumn Header="Họ Và Tên" Binding="{Binding MemberFullName}" FontWeight="SemiBold" Width="240"
                                            HeaderStyle="{StaticResource LeftHeaderStyle}"/>

                        <!-- 4. Số Điện Thoại (Căn giữa) -->
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding MemberPhone}" Width="130" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 5. Loại Yêu Cầu (Căn trái) -->
                        <DataGridTemplateColumn Header="Loại Yêu Cầu" Width="180" HeaderStyle="{StaticResource LeftHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                        <Border CornerRadius="12" Padding="10,3" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Mặc định: Xanh biển -->
                                                    <Setter Property="Background" Value="#F0F9FF"/>
                                                    <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                    <Style.Triggers>
                                                        <!-- Hủy thẻ & hoàn cọc: Tím -->
                                                        <DataTrigger Binding="{Binding RequestType}" Value="CANCEL_CARD">
                                                            <Setter Property="Background" Value="#F5F3FF"/>
                                                            <Setter Property="BorderBrush" Value="#DDD6FE"/>
                                                        </DataTrigger>
                                                        <!-- Báo mất thẻ: Cam -->
                                                        <DataTrigger Binding="{Binding RequestType}" Value="REISSUE_CARD">
                                                            <Setter Property="Background" Value="#FFF7ED"/>
                                                            <Setter Property="BorderBrush" Value="#FFEDD5"/>
                                                        </DataTrigger>
                                                        <!-- Cập nhật thông tin: Xanh biển -->
                                                        <DataTrigger Binding="{Binding RequestType}" Value="UPDATE_INFO">
                                                            <Setter Property="Background" Value="#F0F9FF"/>
                                                            <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                        </DataTrigger>
                                                        <!-- Góp ý: Xanh lá -->
                                                        <DataTrigger Binding="{Binding RequestType}" Value="FEEDBACK_INQUIRY">
                                                            <Setter Property="Background" Value="#F0FDF4"/>
                                                            <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RequestTypeDisplay}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0284C7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequestType}" Value="CANCEL_CARD">
                                                                <Setter Property="Foreground" Value="#6D28D9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RequestType}" Value="REISSUE_CARD">
                                                                <Setter Property="Foreground" Value="#C2410C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RequestType}" Value="UPDATE_INFO">
                                                                <Setter Property="Foreground" Value="#0284C7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RequestType}" Value="FEEDBACK_INQUIRY">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Trạng Thái (Căn trái) -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="150" HeaderStyle="{StaticResource LeftHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                        <Border CornerRadius="4" Padding="8,3" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <!-- Chờ duyệt: Vàng -->
                                                        <DataTrigger Binding="{Binding Status}" Value="PENDING">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                        </DataTrigger>
                                                        <!-- Đã duyệt: Xanh biển -->
                                                        <DataTrigger Binding="{Binding Status}" Value="APPROVED">
                                                            <Setter Property="Background" Value="#F0F9FF"/>
                                                            <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                        </DataTrigger>
                                                        <!-- Từ chối: Đỏ -->
                                                        <DataTrigger Binding="{Binding Status}" Value="REJECTED">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="ClockOutline" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Setter Property="Kind" Value="ClockOutline"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="PENDING">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                    <Setter Property="Kind" Value="ClockOutline"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="APPROVED">
                                                                    <Setter Property="Foreground" Value="#0284C7"/>
                                                                    <Setter Property="Kind" Value="CheckCircleOutline"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="REJECTED">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                    <Setter Property="Kind" Value="CloseCircleOutline"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="PENDING">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="APPROVED">
                                                                    <Setter Property="Foreground" Value="#0369A1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="REJECTED">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Ngày Gửi (Căn giữa) -->
                        <DataGridTextColumn Header="Ngày Gửi" Binding="{Binding FormattedRequestDate}" Width="160" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 8. Thao Tác (Căn giữa) -->
                        <DataGridTemplateColumn Header="Thao Tác" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="30" Padding="10,0" Margin="4,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Focusable="False">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" 
                                                                    Background="#0284C7" 
                                                                    BorderBrush="#0369A1" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="6" 
                                                                    Padding="10,0">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <iconPacks:PackIconMaterial Kind="EyeOutline" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="Chi Tiết" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Phân Trang -->
                <controls:PaginationControl Grid.Row="1" DataContext="{Binding Paging}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
