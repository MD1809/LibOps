<Window x:Class="LibOps.PresentationLayer.Views.RequestDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Chi Tiết &amp; Xử Lý Yêu Cầu Độc Giả" 
        Height="580" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Gradient -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#1E293B" Offset="0.5"/>
                        <GradientStop Color="#3B82F6" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ClipboardListOutline" Width="22" Height="22" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CHI TIẾT &amp; XỬ LÝ YÊU CẦU ĐỘC GIẢ" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock x:Name="txtHeaderSubtitle" Text="Kiểm tra thông tin chi tiết và phê duyệt yêu cầu" FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Thân Dialog -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>
                    <!-- THẺ 1: TÓM TẮT ĐỘC GIẢ & YÊU CẦU -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock x:Name="txtMemberName" Text="Độc giả: Trần Thị Mai (DG202600650)" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="txtRequestCodeAndDate" Text="Mã YC: #REQ-UPD20260001 • Gửi lúc: 13/09/2026 14:30" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Badges Loại YC & Trạng thái -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="badgeStatus" Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtStatus" Text="Chờ duyệt" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                                <Border x:Name="badgeType" Background="#EFF6FF" CornerRadius="6" Padding="8,4">
                                    <TextBlock x:Name="txtRequestType" Text="Cập nhật thông tin" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- THẺ 2: NỘI DUNG CHI TIẾT THEO LOẠI YÊU CẦU -->

                    <!-- 2.1. TRƯỜNG HỢP: HỦY THẺ & HOÀN CỌC -->
                    <StackPanel x:Name="pnlCancelCard" Visibility="Collapsed">
                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số tiền cọc cần giải ngân hoàn trả:" FontSize="11.5" FontWeight="SemiBold" Foreground="#9F1239"/>
                                    <TextBlock x:Name="txtPayoutMethodSummary" Text="Hình thức: Chuyển khoản ngân hàng" FontSize="11" Foreground="#BE123C" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="txtRefundAmount" Text="200.000 đ" FontSize="17" FontWeight="Bold" Foreground="#BE123C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Khung Chuyển Khoản Ngân Hàng (Không cần mã QR, hiển thị rõ ràng STK) -->
                        <StackPanel x:Name="pnlBankTransferInfo">
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="THÔNG TIN TÀI KHOẢN THỤ HƯỞNG CỦA ĐỘC GIẢ:" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="txtBankName" Text="Ngân hàng: MBBank" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="txtAccountNo" Text="Số TK: 0987654321" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="txtAccountHolder" Text="Chủ TK: TRẦN THỊ MAI" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Row="0" Grid.Column="1" Click="CopyAccount_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="10,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Sao chép STK" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,10" Background="#DBEAFE"/>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                        <TextBlock Text="Nội dung chuyển khoản đề xuất:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="txtTransferContent" Text="HOAN COC THE DG202600650" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrandIndigoBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Khung Tiền Mặt -->
                        <Border x:Name="pnlCashInfo" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HÌNH THỨC: CHI TIỀN MẶT TẠI QUẦY" FontWeight="Bold" FontSize="12" Foreground="#166534" Margin="0,0,0,4"/>
                                <TextBlock Text="Thủ thư chi trả tiền mặt trực tiếp cho độc giả. Khi duyệt, hệ thống sẽ xuất Phiếu Chi tiền mặt để độc giả ký nhận." FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2.2. TRƯỜNG HỢP: BÁO MẤT THẺ -->
                    <Border x:Name="pnlReissueCardInfo" Visibility="Collapsed" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="16" Height="16" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="THẺ HIỆN TẠI ĐÃ ĐƯỢC HỆ THỐNG TỰ ĐỘNG TẠM KHÓA (LOCKED)" FontWeight="Bold" FontSize="11.5" Foreground="#B45309" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Lý do &amp; Thông tin báo mất từ độc giả:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock x:Name="txtReissueReason" Text="Rơi ví mất thẻ thư viện" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="💡 Khi bấm Phê Duyệt, thẻ sẽ được mở khóa lại và ghi nhận để thủ thư cấp phôi thẻ mới cho độc giả tại quầy." FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 2.3. TRƯỜNG HỢP: CẬP NHẬT THÔNG TIN CÁ NHÂN -->
                    <Border x:Name="pnlUpdateInfoSection" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="NỘI DUNG YÊU CẦU THAY ĐỔI THÔNG TIN:" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock x:Name="txtUpdateDetails" Text="[CẬP NHẬT] SĐT: 0988889999 | Email: reader@phenikaa.edu.vn" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>
                            <TextBlock Text="💡 Khi bấm Phê Duyệt, hệ thống sẽ tự động cập nhật thông tin mới vào hồ sơ Độc giả và tài khoản đăng nhập." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 2.4. TRƯỜNG HỢP: GÓP Ý / HỖ TRỢ DỊCH VỤ -->
                    <Border x:Name="pnlFeedbackSection" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="NỘI DUNG GÓP Ý / PHẢN HỒI CỦA BẠN ĐỌC:" FontWeight="Bold" FontSize="11.5" Foreground="#166534" Margin="0,0,0,6"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock x:Name="txtFeedbackDetails" Text="Nội dung thắc mắc hoặc phản ánh của độc giả" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>
                            <TextBlock Text="💡 Nhập câu trả lời/giải đáp của bạn vào ô bên dưới để phản hồi trực tiếp cho độc giả." FontSize="11" Foreground="#15803D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- THẺ 3: Ý KIẾN / PHẢN HỒI CỦA THỦ THƯ -->
                    <TextBlock Text="Ý KIẾN XỬ LÝ / NỘI DUNG PHẢN HỒI CỦA THỦ THƯ (*):" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                    <TextBox x:Name="txtStaffNotes" Style="{StaticResource ModernTextBox}" Height="65" TextWrapping="Wrap" AcceptsReturn="True" Text="Đã kiểm tra và phê duyệt yêu cầu thành công"/>

                    <!-- THẺ 4: THÔNG TIN LỊCH SỬ DUYỆT (HIỆN KHI ĐÃ DUYỆT HOẶC TỪ CHỐI) -->
                    <Border x:Name="pnlProcessedHistory" Visibility="Collapsed" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtProcessedByInfo" Text="Đã xử lý bởi: Thủ thư Nguyễn Văn A • Ngày xử lý: 13/09/2026 15:00" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Buttons -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Đóng" Click="CloseButton_Click" Style="{StaticResource OutlineButton}" Height="38" Padding="16,0"/>

                    <!-- Nút Từ Chối (Chỉ hiện khi PENDING) -->
                    <Button Grid.Column="2" x:Name="btnReject" Click="RejectButton_Click" Style="{StaticResource DangerButton}" Height="38" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Từ Chối" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Phê Duyệt (Chỉ hiện khi PENDING) -->
                    <Button Grid.Column="3" x:Name="btnApprove" Click="ApproveButton_Click" Style="{StaticResource SuccessButton}" Height="38" Padding="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtApproveBtnText" Text="Phê Duyệt &amp; Thực Thi" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
