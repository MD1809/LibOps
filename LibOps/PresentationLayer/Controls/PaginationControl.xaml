<UserControl x:Class="LibOps.PresentationLayer.Controls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignWidth="800" d:DesignHeight="48">

    <UserControl.Resources>
        <!-- Modern Pagination Button Style -->
        <Style x:Key="PagingNavButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEF2FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#A5B4FC" />
                                <Setter Property="Foreground" Value="{StaticResource BrandIndigoBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8" />
                                <Setter Property="Foreground" Value="{StaticResource BrandIndigoBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="14,6" CornerRadius="0,0,8,8">
        <Grid>
            <!-- Left side: Summary Information Badge -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" 
                    CornerRadius="6" Padding="10,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="FormatListNumbered" Width="14" Height="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Hiển thị " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StartItemIndex}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" - " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EndItemIndex}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" / " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" bản ghi" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Right side: Navigation Controls Group -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- First Page -->
                <Button Command="{Binding FirstPageCommand}" 
                        Style="{StaticResource PagingNavButton}" 
                        Margin="0,0,4,0" 
                        ToolTip="Trang đầu (First)">
                    <iconPacks:PackIconMaterial Kind="ChevronDoubleLeft" Width="15" Height="15" VerticalAlignment="Center"/>
                </Button>

                <!-- Previous Page -->
                <Button Command="{Binding PreviousPageCommand}" 
                        Style="{StaticResource PagingNavButton}" 
                        Margin="0,0,6,0" 
                        ToolTip="Trang trước (Prev)">
                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                </Button>

                <!-- Current Page Info Pill -->
                <Border Background="#F5F3FF" 
                        BorderBrush="#DDD6FE" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,0" 
                        Height="32" 
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Trang " FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" FontSize="12" Foreground="#7C3AED" VerticalAlignment="Center" />
                        <TextBlock Text=" / " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Next Page -->
                <Button Command="{Binding NextPageCommand}" 
                        Style="{StaticResource PagingNavButton}" 
                        Margin="0,0,4,0" 
                        ToolTip="Trang sau">
                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center"/>
                </Button>

                <!-- Last Page -->
                <Button Command="{Binding LastPageCommand}" 
                        Style="{StaticResource PagingNavButton}" 
                        ToolTip="Trang cuối">
                    <iconPacks:PackIconMaterial Kind="ChevronDoubleRight" Width="15" Height="15" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
